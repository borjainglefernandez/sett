# Copy to /opt/sett/.env on the VPS (chmod 600). Never commit the real file.

# --- database (sett-db container) ---
POSTGRES_USER=sett
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sett
DATABASE_URL=postgresql+asyncpg://sett:change-me@sett-db:5432/sett
# Prod uses Alembic migrations; keep auto-create off.
AUTO_CREATE_SCHEMA=0

# --- auth ---
JWT_SECRET=generate-with--openssl-rand-hex-32
APPLE_BUNDLE_ID=com.borja.sett
ACCESS_TTL_SEC=3600
REFRESH_TTL_DAYS=90

# --- oura ---
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=https://sett.example.com/v1/oura/callback
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OURA_TOKEN_KEY=
OURA_DEEPLINK=sett://oura/connected

# --- AI digests ---
ANTHROPIC_API_KEY=
DIGEST_MODEL=claude-haiku-4-5
ANALYZE_DAILY_LIMIT=3
MONTHLY_BUDGET_USD=1.00

# --- meta ---
API_VERSION=2.0.0
MIN_CLIENT_BUILD=1

# --- backups (worker; omit bucket to disable) ---
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=sett/pg
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1

# --- monitoring (optional healthchecks.io dead-man pings) ---
HC_PING_OURA=
HC_PING_DIGEST=
HC_PING_BACKUP=
SENTRY_DSN=
